// Generated from app.models; regenerate with python -m app.export_schema

Table media_titles {
  provider varchar(10) [not null]
  external_id text [not null]
  media_type varchar(10) [not null]
  title text [not null]
  original_title text [null]
  description text [null]
  description_language varchar(10) [null]
  poster_url text [null]
  release_date date [null]
  genres text [null]
  seasons_count integer [null]
  fetched_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  id uuid [not null, pk, default: `gen_random_uuid()`]
  indexes {
    (provider, media_type, external_id) [unique]
  }
  checks {
    `(description IS NULL AND description_language IS NULL) OR (description IS NOT NULL AND description_language IS NOT NULL AND description_language IN ('uk', 'en') AND length(btrim(description)) > 0)`
    `(provider = 'tmdb' AND media_type IN ('movie', 'series')) OR (provider = 'rawg' AND media_type = 'game')`
    `external_id = btrim(external_id) AND length(external_id) > 0`
    `title = btrim(title) AND length(title) > 0`
  }
}

Table users {
  email varchar(254) [not null]
  username varchar(50) [not null]
  password_hash text [not null]
  avatar_url text [null]
  id uuid [not null, pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (`lower(email)`) [unique]
    (`lower(username)`) [unique]
  }
  checks {
    `email = btrim(email) AND length(email) > 0`
    `length(btrim(password_hash)) > 0`
    `username = btrim(username) AND length(username) > 0`
  }
}

Table library_entries {
  user_id uuid [not null]
  title_id uuid [not null]
  status varchar(20) [not null, default: `'planned'`]
  rating smallint [null]
  review_text text [null]
  review_updated_at timestamptz [null]
  completed_at timestamptz [null]
  current_season integer [null]
  current_episode integer [null]
  id uuid [not null, pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (title_id)
    (user_id, title_id) [unique]
  }
  checks {
    `rating IS NULL OR rating BETWEEN 1 AND 10`
    `status IN ('planned', 'in_progress', 'completed', 'on_hold', 'dropped')`
  }
}

Table seasons {
  title_id uuid [not null]
  season_number integer [not null]
  name text [null]
  air_date date [null]
  episodes_fetched_at timestamptz [null]
  id uuid [not null, pk, default: `gen_random_uuid()`]
  indexes {
    (title_id, season_number) [unique]
  }
  checks {
    `season_number >= 0`
  }
}

Table episodes {
  season_id uuid [not null]
  episode_number integer [not null]
  name text [null]
  air_date date [null]
  runtime_minutes integer [null]
  id uuid [not null, pk, default: `gen_random_uuid()`]
  indexes {
    (season_id, episode_number) [unique]
  }
  checks {
    `episode_number >= 1`
    `runtime_minutes IS NULL OR runtime_minutes > 0`
  }
}

Table watched_episodes {
  library_entry_id uuid [not null]
  episode_id uuid [not null]
  watched_at timestamptz [not null, default: `now()`]
  indexes {
    (episode_id)
    (library_entry_id, episode_id) [pk]
  }
}

Ref: library_entries.title_id > media_titles.id [delete: restrict]
Ref: library_entries.user_id > users.id [delete: cascade]
Ref: seasons.title_id > media_titles.id [delete: cascade]
