# Backend
DATABASE_URL=
TEST_DATABASE_URL=
TMDB_API_KEY=
# Unused: games come from the Steam Store API (no key). Optional, can stay empty.
RAWG_API_KEY=

# Auth / sessions. In production set your own JWT_SECRET (openssl rand -hex 32)
# and SESSION_COOKIE_SECURE=true (HTTPS only).
# JWT_SECRET=
SESSION_COOKIE_SECURE=false
# Where the frontend is opened from (CORS). In production: https://<service>.onrender.com
FRONTEND_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
